{
  "name": "@blzvi/asana-mcp-server",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.0",
  "description": "MCP server that gives AI assistants full access to the Asana API — 86 tools, 35 prompt templates, and browsable resources",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "asana-mcp-server": "build/index.js"
  },
  "files": [
    "build",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:logging": "node scripts/check-logging.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check:logging && npm run build && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BLZvi/asana-mcp-server.git"
  },
  "homepage": "https://github.com/BLZvi/asana-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/BLZvi/asana-mcp-server/issues"
  },
  "keywords": [
    "asana",
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "llm",
    "project-management",
    "task-management",
    "automation",
    "anthropic",
    "mcp-server"
  ],
  "author": "Zvi Blitsman",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@modelcontextprotocol/inspector": "^0.4.0",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xmldom/xmldom": "^0.8.11",
    "asana": "^3.0.12",
    "zod": "^4.3.6"
  }
}
